{
  "dataset_type": "cmapss",

  "cmapss": {
    "dataset": "FD004",
    "data_path": "Cmapss_data",
    "output_path": "train_dataset",
    "window_size": 60,
    "rul_max": 125.0,
    "feature_len": 14,
    "condition_scaling_enabled": true,
    "condition_scaling_method": "zscore",
    "condition_cluster_count": 6
  },

  "femto": {
    "femto_path": "phm2012_dataset",
    "output_path": "femto_dataset/",
    "window_size": 60,
    "feature_len": 16,
    "condition": "3"
  },

  "training": {
    "batch_size": 256,
    "epochs": 100,
    "learning_rate": 0.001,
    "grad_clip_enabled": false,
    "grad_clip_max_norm": 1.0,
    "lr_warmup_enabled": false,
    "lr_warmup_epochs": 5,
    "model_save_path": "model",
    "seed": 42
  },

  "model": {
    "dec_seq_len": 10,
    "out_seq_len": 1,
    "dim_val": 64,
    "dim_attn": 64,
    "n_encoder_layers": 2,
    "n_decoder_layers": 1,
    "n_heads": 4,
    "dropout": 0.1,
    "use_full_features_for_time_encoder": false
  }
}
