    "grad_clip_enabled": false,
    "grad_clip_max_norm": 1.0,
    "lr_warmup_enabled": false,
    "lr_warmup_epochs": 10,
    "model_save_path": "experiments/cmapss_no_clip_no_warmup/checkpoints",
    "seed": 42,
    "experiment_name": "cmapss_no_clip_no_warmup"
  },
  "model": {
    "dec_seq_len": 4,
    "out_seq_len": 1,
    "dim_val": 64,
    "dim_attn": 64,
    "n_encoder_layers": 2,
    "n_decoder_layers": 1,
    "n_heads": 4,
    "dropout": 0.2,
    "use_full_features_for_time_encoder": false
  }
